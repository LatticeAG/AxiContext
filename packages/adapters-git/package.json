{
  "name": "@latticeag/axicontext-adapter-git",
  "version": "0.1.0",
  "description": "Git source adapter for AxiContext sync ingestion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LatticeAG/AxiContext.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@latticeag/axicontext-core": "workspace:*",
    "@latticeag/axicontext-parsers": "workspace:*",
    "fast-glob": "^3.3.3"
  }
}
