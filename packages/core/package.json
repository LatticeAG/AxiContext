{
  "name": "@latticeag/axicontext-core",
  "version": "0.1.0",
  "description": "AxiContext core types, config, and scaffolding.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LatticeAG/AxiContext.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@latticeag/axicontext-adapter-git": "workspace:*",
    "zod": "^3.25.76"
  }
}
