{
  "name": "@latticeag/axicontext",
  "version": "0.1.0",
  "description": "AxiContext command line interface.",
  "type": "module",
  "main": "dist/bin.js",
  "types": "dist/bin.d.ts",
  "bin": {
    "axictx": "dist/bin.js"
  },
  "files": [
